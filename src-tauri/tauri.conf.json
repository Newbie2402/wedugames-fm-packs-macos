{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wedugames FM Packs",
  "version": "0.1.0",
  "identifier": "com.wedugames.fmpacks",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Wedugames FM Packs",
        "width": 1160,
        "height": 760,
        "minWidth": 940,
        "minHeight": 620,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0a0e13"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.ico"]
  }
}
